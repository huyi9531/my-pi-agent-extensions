{
  "name": "pi-doubao-search",
  "version": "0.1.1",
  "description": "pi 扩展：doubao_web_search —— 豆包搜索（火山引擎联网搜索 Custom 版）网页/图片搜索工具，支持时间范围、限定站点、权威度过滤与正文返回。",
  "author": "aiconductor",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "doubao",
    "web-search",
    "search",
    "volcengine",
    "bytedance"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "config.ts",
    "format.ts",
    "search.ts",
    "text.ts",
    "tests/",
    "tsconfig.portable.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.portable.json",
    "typecheck:local": "tsc -p tsconfig.json",
    "prepack": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  }
}
